*.wal
*.sst
data/

# Binaries and local build outputs
bin/
forest_server

# Generated TLS certificates
*.pem
*.crt
*.key

# Antigravity dynamic links (rebuilt per workspace; tracked via .agent/.active-skills.json)
.agent/skills/*
!.agent/skills/.gitkeep
